# Everything is optional. With nothing set, the store runs as a read-only demo
# that serves the bundled catalog.

# SQLite: a local file, or a Turso URL (libsql://...) plus an auth token.
DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=

# Clerk (https://dashboard.clerk.com). Both keys are needed to enable sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Stripe in test mode. Without it, paid games are granted without payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
